<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:fitsSystemWindows="true"
    app:cardCornerRadius="6dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/item_card_seeker_profile_picture"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:scaleType="fitXY"
            tools:src="@drawable/frieren" />

        <TextView
            android:id="@+id/item_card_seeker_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/item_card_seeker_profile_picture"
            android:fontFamily="sans-serif-medium"
            android:textColor="#212121"
            android:textSize="18sp"
            tools:text="Seeker Name goes here" />

        <TextView
            android:id="@+id/text_view_job_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_card_seeker_name"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/item_card_seeker_profile_picture"
            android:fontFamily="sans-serif"
            android:textColor="@color/manila_blue"
            android:textSize="11sp"
            tools:text="Job Title" />

        <TextView
            android:id="@+id/item_card_message_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/text_view_job_title"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/item_card_seeker_profile_picture"
            android:fontFamily="sans-serif"
            android:textColor="#616161"
            android:textSize="12sp"
            tools:text="Message details goes here" />

        <TextView
            android:id="@+id/text_view_chat_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="#616161"
            tools:text="11:11pm" />

        <TextView
            android:id="@+id/text_view_unread_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_below="@id/text_view_chat_timestamp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_status_pending"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>