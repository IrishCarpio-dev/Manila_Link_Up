<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Unread indicator dot -->
        <View
            android:id="@+id/view_unread_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/item_card_notif_image_type"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="14dp"
            android:scaleType="fitXY"
            tools:src="@drawable/chat_notif_icon" />

        <TextView
            android:id="@+id/item_card_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="48dp"
            android:layout_toEndOf="@id/item_card_notif_image_type"
            android:layout_alignParentEnd="true"
            android:fontFamily="sans-serif-medium"
            android:textColor="#212121"
            android:textSize="15sp"
            tools:text="Notification Title" />

        <TextView
            android:id="@+id/item_card_notif_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/item_card_notif_title"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@id/item_card_notif_image_type"
            android:layout_alignParentEnd="true"
            android:fontFamily="sans-serif"
            android:textColor="#616161"
            android:textSize="12sp"
            tools:text="Notification details go here" />

        <TextView
            android:id="@+id/text_view_notif_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:fontFamily="sans-serif"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            tools:text="3h ago" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
