<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="#0D47A1"
        app:itemIconTint="@android:color/white"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_nav_menu" />

    <LinearLayout
        android:id="@+id/container_action_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/white">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            style="@style/AppButtonMuted"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_apply"
            style="@style/AppButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Apply" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/container_action_buttons"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/view_company_logo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="#0D47A1" />

                <ImageView
                    android:id="@+id/image_report"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#000000" />
            </RelativeLayout>

            <TextView
                android:id="@+id/text_job_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Event/Catering Helper"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_company_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eng Bee Tin"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Binondo, Manila."
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 P700/Day"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 March 30, 2026"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0E0E0" />

            <TextView
                android:id="@+id/text_header_responsibilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textSize="17sp" />

            <TextView android:id="@+id/text_resp_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/text_resp_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/text_resp_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/text_header_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textSize="17sp" />

            <TextView android:id="@+id/text_overview_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/text_overview_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/text_header_requirements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textSize="17sp" />

            <TextView android:id="@+id/text_req_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/text_req_2" android:layout_width="match_parent" android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
