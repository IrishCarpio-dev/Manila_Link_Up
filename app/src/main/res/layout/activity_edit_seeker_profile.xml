<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/design_default_color_background" />


        <ImageView
            android:id="@+id/image_view_insert_photo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_below="@id/toolbar"
            android:layout_centerHorizontal="true"
            android:src="@drawable/insert_photo" />

        <TextView
            android:id="@+id/text_view_upload_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/image_view_insert_photo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Upload Profile Photo"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/lblClearance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/text_view_upload_photo"
            android:layout_marginStart="30dp"
            android:layout_marginTop="32dp"
            android:text="Upload clearance"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subClearance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblClearance"
            android:layout_marginStart="30dp"
            android:text="(Ex. Nbi, Police, \nBarangay Clearance)"
            android:textColor="@android:color/darker_gray" />

        <Button
            android:id="@+id/btnUploadClearance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/lblClearance"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="30dp"
            android:backgroundTint="#283593"
            android:drawableStart="@android:drawable/stat_sys_upload"
            android:text="Upload"
            app:cornerRadius="12dp"
            app:icon="@drawable/arrowup2" />

        <TextView
            android:id="@+id/lblID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/subClearance"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Upload Valid ID"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblID"
            android:layout_marginStart="30dp"
            android:text="(Ex. Passport, Driver's License, \nUMID, Postal ID etc."
            android:textColor="@android:color/darker_gray" />


        <Button
            android:id="@+id/btnUploadID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/lblID"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="30dp"
            android:backgroundTint="#283593"
            android:drawableStart="@android:drawable/stat_sys_upload"
            android:text="Upload"
            app:cornerRadius="12dp"
            app:icon="@drawable/arrowup2" />

        <TextView
            android:id="@+id/lblLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/subID"
            android:layout_marginStart="30dp"
            android:layout_marginTop="24dp"
            android:text="Preferred Location"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/lblLocation"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:background="#F0F0F0"
            android:hint="Enter your location"
            android:importantForAccessibility="yes"
            android:paddingLeft="12dp" />

        <TextView
            android:id="@+id/lblDOB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etLocation"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Date of Birth"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDOB"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/lblDOB"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:background="#F0F0F0"
            android:hint="MM / DD /YR"
            android:paddingLeft="12dp" />

        <TextView
            android:id="@+id/lblSalary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etDOB"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Preferred Salary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSalaryType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblSalary"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:background="#F9F9F9"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Choose salary type" />

            <RadioButton
                android:id="@+id/rbHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Per Hour" />

            <RadioButton
                android:id="@+id/rbDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Day" />

            <RadioButton
                android:id="@+id/rbMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Month" />
        </RadioGroup>

        <TextView
            android:id="@+id/lblRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rgSalaryType"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Salary Range"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSalaryRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblRange"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:background="#F9F9F9"
            android:minHeight="100dp" />
        
        <EditText
            android:id="@+id/etCustomSalary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/rvSalaryRange"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:hint="(Want something specific? Type you salary here!)"
            android:background="#F9F9F9"
            android:inputType="number"
            android:textSize="14sp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/material_button_save"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_below="@id/etCustomSalary"
            android:layout_marginStart="100dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="100dp"
            android:layout_marginBottom="8dp"
            android:text="Save"
            android:textSize="20sp"
            app:backgroundTint="#0D47A1"
            app:cornerRadius="12dp" />

    </RelativeLayout>


</ScrollView>