<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/design_default_color_background" />


        <ImageView
            android:id="@+id/image_view_insert_photo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_below="@id/toolbar"
            android:layout_centerHorizontal="true"
            android:src="@drawable/insert_photo" />

        <TextView
            android:id="@+id/text_view_upload_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/image_view_insert_photo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Upload Profile Photo"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/lblClearance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/text_view_upload_photo"
            android:layout_marginStart="30dp"
            android:layout_marginTop="32dp"
            android:text="Upload clearance"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subClearance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblClearance"
            android:layout_marginStart="30dp"
            android:text="(Ex. Nbi, Police, \nBarangay Clearance)"
            android:textColor="@android:color/darker_gray" />

        <Button
            android:id="@+id/btnUploadClearance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:layout_alignTop="@id/lblClearance"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#283593"
            android:drawableStart="@android:drawable/stat_sys_upload"
            android:text="Upload" />

        <TextView
            android:id="@+id/lblID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/subClearance"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Upload Valid ID"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUploadID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/lblID"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="30dp"
            android:backgroundTint="#283593"
            android:drawableStart="@android:drawable/stat_sys_upload"
            android:text="Upload" />

        <TextView
            android:id="@+id/lblLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblID"
            android:layout_marginStart="30dp"
            android:layout_marginTop="24dp"
            android:text="Preferred Location"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_below="@id/lblLocation"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:background="#F0F0F0"
            android:paddingLeft="12dp" />

        <TextView
            android:id="@+id/lblDOB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etLocation"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Date of Birth"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDOB"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_below="@id/lblDOB"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:background="#F0F0F0"
            android:hint="MM / DD /YR"
            android:paddingLeft="12dp" />

        <TextView
            android:id="@+id/lblSalary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etDOB"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Preferred Salary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSalaryType"
            android:layout_width="match_parent"
            android:layout_marginEnd="30dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblSalary"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose salary type"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Hour" />

            <RadioButton
                android:id="@+id/rbDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Day" />

            <RadioButton
                android:id="@+id/rbMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per Month" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/rgSalaryRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rgSalaryType"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="24dp"
            android:background="#F5F5F5"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salary Range"
                android:textSize="14sp" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Below 50/Hour" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 - 100/Hour" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 - 150/Hour" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150 - 200/Hour" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200 - 300/Hour" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300 - 500/Hour" />

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500+/Hour" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/material_button_verify"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_below="@id/rgSalaryRange"
            android:layout_marginStart="100dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="100dp"
            android:layout_marginBottom="8dp"
            android:text="Verify"
            android:textSize="20sp"
            app:backgroundTint="#0D47A1"
            app:cornerRadius="12dp" />

    </RelativeLayout>


</ScrollView>