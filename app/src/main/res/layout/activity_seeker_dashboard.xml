<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1B3E9C"
        app:itemIconTint="@color/bottom_nav_icon_colors"
        app:itemTextColor="@color/bottom_nav_icon_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu_icons" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_dashboard_top_seeker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B3E9C"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textview_greeting_seeker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Good morning, "
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textview_greeting_name_seeker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seekername"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/search_bar_background"
                android:drawableStart="@drawable/search_icon"
                android:drawablePadding="10dp"
                android:hint="Find your next opportunity"
                android:padding="10dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_view_recommendations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_view_dashboard_top_seeker"
        android:layout_margin="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#212121"
        android:textSize="18sp"
        tools:text="Recommendations" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_job_posts_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/text_view_recommendations"
        tools:listitem="@layout/item_job_post_card">

    </androidx.recyclerview.widget.RecyclerView>


</RelativeLayout>