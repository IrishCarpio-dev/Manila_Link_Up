<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/manila_blue"
        android:theme="@style/ThemeOverlay.ManilaBluToolbar"
        app:navigationIconTint="@color/white">

        <TextView
            android:id="@+id/text_view_employer_name_job_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Employer Name"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body" />

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_save_apply_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_application"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:text="Withdraw"
            android:textAllCaps="false"
            android:textColor="#D32F2F"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_chat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp"
            app:strokeColor="#D32F2F"
            app:strokeWidth="1.5dp"
            app:rippleColor="#15D32F2F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/manila_blue"
            android:text="Chat"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/button_cancel_application"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mark_complete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/manila_blue"
            android:text="Mark Job Complete"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Rate Employer"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_save_apply_buttons"
        android:layout_below="@id/toolbar"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <androidx.cardview.widget.CardView
                android:id="@+id/card_view_job_post_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <ImageView
                        android:id="@+id/image_view_employer_cover_photo_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/coverphotosamp">


                    </ImageView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_view_logo_container"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/padding_large"
                        android:layout_marginBottom="@dimen/padding_standard"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="8dp"
                        app:cardPreventCornerOverlap="false">

                        <ImageView
                            android:id="@+id/image_view_employee_profile_picture_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/chipsstarters" />

                    </androidx.cardview.widget.CardView>

                    <ImageView
                        android:id="@+id/image_view_report_button_job_post"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="@dimen/padding_standard"
                        android:contentDescription="Report"
                        android:scaleType="centerInside"
                        android:src="@drawable/report_caution_logo" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_view_employer_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/card_view_job_post_header"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/light_bg"
                    android:padding="@dimen/padding_standard">

                    <TextView
                        android:id="@+id/text_view_employer_job_title_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/dark_text"
                        android:textSize="@dimen/text_large"
                        android:text="Employer Job Title" />

                    <TextView
                        android:id="@+id/applied_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:paddingHorizontal="@dimen/padding_small"
                        android:paddingVertical="4dp"
                        android:text="UNDER REVIEW"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:background="@drawable/bg_status_pending" />

                    <TextView
                        android:id="@+id/text_view_employer_name_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/text_view_employer_job_title_placeholder"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"
                        android:text="Employer Name" />

                    <LinearLayout
                        android:id="@+id/row_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/text_view_employer_name_placeholder"
                        android:layout_marginTop="@dimen/padding_standard"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/location_logo"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/location3" />

                        <TextView
                            android:id="@+id/text_view_location_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/padding_small"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_small"
                            android:text="Binondo, Manila" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_salary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/row_location"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/money_logo"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/moneybill" />

                        <TextView
                            android:id="@+id/text_view_salary_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/padding_small"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_small"
                            android:text="&#8369;700/hr" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_calendar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/row_salary"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/calendar_logo"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/bxscalendarcheck" />

                        <TextView
                            android:id="@+id/text_view_calendar_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/padding_small"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_small"
                            android:text="Apr. 4-8, 2026" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/applied_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/row_calendar"
                        android:layout_marginTop="4dp"
                        android:text="Applied: Apr 08, 2026"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/text_view_job_description_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/card_view_employer_info"
                android:layout_margin="@dimen/padding_standard"
                android:textColor="@color/secondary_text"
                android:text="Job Description will go here" />
        </RelativeLayout>

    </ScrollView>
</RelativeLayout>
